{
  "compilerOptions": {
    "jsx": "react-jsx", // Usando o JSX Transform do React 17+
    "types": ["react", "react-dom"], // Certifique-se de que os tipos do React estão incluídos
    "target": "ES2020", 
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "strict": true,
    "allowImportingTsExtensions": true, // Garantindo que a importação de arquivos .tsx seja permitida
    "composite": true, // Ativando a composição para referenciar esse projeto
    "emitDeclarationOnly": true // Se não quiser gerar código, mas ainda gerar declarações
  },
  "include": ["src/**/*"]
}